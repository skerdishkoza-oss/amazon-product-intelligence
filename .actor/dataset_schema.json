{
    "actorSpecification": 1,
    "title": "Amazon product intelligence results",
    "description": "Successful product rows and structured failure rows. The status field identifies the row type.",
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "schemaVersion": {
                "type": "string",
                "title": "Schema version",
                "description": "Version of the stable output contract.",
                "example": "1.5"
            },
            "status": {
                "type": "string",
                "title": "Result status",
                "description": "SUCCESS for a product row; otherwise the structured failure category.",
                "example": "SUCCESS"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped at",
                "description": "UTC time at which the Amazon response was received.",
                "example": "2026-09-20T10:00:00Z"
            },
            "input": {
                "type": "object",
                "title": "Input",
                "description": "The input value and input type that produced this row."
            },
            "marketplace": {
                "type": ["string", "null"],
                "title": "Marketplace",
                "description": "US, UK, DE, FR, IT, ES, or CA.",
                "example": "US"
            },
            "asin": {
                "type": ["string", "null"],
                "title": "ASIN",
                "description": "Normalized ten-character Amazon product identifier.",
                "example": "B0CX23V2ZK"
            },
            "title": {
                "type": ["string", "null"],
                "title": "Product title"
            },
            "brand": {
                "type": ["string", "null"],
                "title": "Brand"
            },
            "canonicalUrl": {
                "type": "string",
                "title": "Canonical URL",
                "description": "Canonical marketplace product URL."
            },
            "retrieval": {
                "type": "object",
                "title": "Retrieval profile",
                "description": "Selected profile, requested data blocks, and base billing event for this row."
            },
            "pricing": {
                "type": "object",
                "title": "Pricing",
                "description": "Normalized money values, raw text, source, and extraction status."
            },
            "availability": {
                "type": "object",
                "title": "Availability",
                "description": "Stock, delivery, Prime, shipping, and seller availability signals."
            },
            "rankings": {
                "type": "object",
                "title": "Rankings",
                "description": "Best Sellers Rank entries and bought-in-past-month signal."
            },
            "ratings": {
                "type": "object",
                "title": "Ratings",
                "description": "Rating, review count, optional distribution, and extraction status."
            },
            "buyBox": {
                "type": "object",
                "title": "Buy Box"
            },
            "variants": {
                "type": "object",
                "title": "Variants"
            },
            "product": {
                "type": "object",
                "title": "Product content",
                "description": "Bullets, description, specifications and category breadcrumb."
            },
            "media": {
                "type": "object",
                "title": "Media",
                "description": "Main image, normalized gallery images and product videos."
            },
            "offers": {
                "type": "object",
                "title": "Offers",
                "description": "Bounded seller offers with item, shipping and landed prices."
            },
            "sellerProfiles": {
                "type": "object",
                "title": "Seller profiles",
                "description": "Public seller feedback and business fields with source URLs."
            },
            "monitoring": {
                "type": "object",
                "title": "Monitoring",
                "description": "Field-level changes from a previous dataset."
            },
            "location": {
                "type": "object",
                "title": "Location",
                "description": "Requested and resolved delivery-location context."
            },
            "quality": {
                "type": "object",
                "title": "Quality",
                "description": "Completeness, attempts, proxy tier, parser version, and warnings."
            },
            "discoveredFrom": {
                "type": "array",
                "title": "Discovered from",
                "description": "All direct or discovery sources merged into this product row."
            },
            "attempts": {
                "type": "integer",
                "title": "Attempts",
                "description": "Fetch attempts for a failure row."
            },
            "reason": {
                "type": "string",
                "title": "Failure reason",
                "description": "Machine-readable reason on non-success rows."
            },
            "lastProxyTier": {
                "type": "string",
                "title": "Last proxy tier"
            }
        }
    },
    "views": {
        "results": {
            "title": "Results",
            "transformation": {
                "fields": [
                    "status",
                    "scrapedAt",
                    "marketplace",
                    "asin",
                    "title",
                    "brand",
                    "retrieval",
                    "pricing",
                    "availability",
                    "rankings",
                    "ratings",
                    "buyBox",
                    "variants",
                    "product",
                    "media",
                    "offers",
                    "sellerProfiles",
                    "monitoring",
                    "location",
                    "quality",
                    "discoveredFrom",
                    "canonicalUrl"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "scrapedAt": { "label": "Scraped at", "format": "date" },
                    "canonicalUrl": { "label": "Product URL", "format": "link" }
                }
            }
        },
        "diagnostics": {
            "title": "Status and failure diagnostics",
            "transformation": {
                "fields": ["status", "scrapedAt", "marketplace", "input", "asin", "attempts", "reason", "lastProxyTier"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "scrapedAt": { "label": "Scraped at", "format": "date" }
                }
            }
        }
    }
}
